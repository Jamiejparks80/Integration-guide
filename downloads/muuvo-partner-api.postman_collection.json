    {
      "name": "Tenancies",
      "item": [
        {
          "name": "List all tenancies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tenancies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tenancies"
              ],
              "variable": []
            },
            "description": "Returns a summary of every tenancy on your account."
          }
        },
        {
          "name": "Create a pre-tenancy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tenancies",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tenancies"
              ],
              "variable": []
            },
            "description": "Use it for the outgoing tenancy when notice is given, and for each new tenancy once references are passed. The pre-tenancy builder on this page generates this body.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenancyStart\": \"string\",\n  \"tenancyEnd\": \"string\",\n  \"propertyId\": 0,\n  \"sendCouncilAndUtilityNotifications\": true,\n  \"whoIsResponsibleForTheVoidPeriod\": \"string\",\n  \"voidBillCorrespondenceAddress\": \"string\",\n  \"isFurnished\": true,\n  \"areAnyBillsIncludedInTheRent\": {\n    \"councilTax\": true,\n    \"gas\": true,\n    \"electric\": true,\n    \"water\": true\n  },\n  \"tenantServiceOptIn-Media\": true,\n  \"tenantServiceOptIn-Energy\": true,\n  \"voidService\": true,\n  \"gasMeterReading\": \"string\",\n  \"gasMeterReadingDate\": \"string\",\n  \"electricMeterReading\": \"string\",\n  \"electricMeterReading_2\": \"string\",\n  \"electricMeterReadingDate\": \"string\",\n  \"waterMeterReading\": \"string\",\n  \"waterMeterReadingDate\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get the full tenancy",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tenancies/:tenancyId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tenancies",
                ":tenancyId"
              ],
              "variable": [
                {
                  "key": "tenancyId",
                  "value": "0"
                }
              ]
            },
            "description": "Returns the tenancy, meters with readings, and tenants."
          }
        },
        {
          "name": "Update a tenancy",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tenancies/:tenancyId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tenancies",
                ":tenancyId"
              ],
              "variable": [
                {
                  "key": "tenancyId",
                  "value": "0"
                }
              ]
            },
            "description": "Use the stored tenancy ID for any change. Posting again would create a duplicate.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenancyStart\": \"string\",\n  \"tenancyEnd\": \"string\",\n  \"propertyId\": 0,\n  \"sendCouncilAndUtilityNotifications\": true,\n  \"whoIsResponsibleForTheVoidPeriod\": \"string\",\n  \"voidBillCorrespondenceAddress\": \"string\",\n  \"isFurnished\": true,\n  \"areAnyBillsIncludedInTheRent\": {\n    \"councilTax\": true,\n    \"gas\": true,\n    \"electric\": true,\n    \"water\": true\n  },\n  \"tenantServiceOptIn-Media\": true,\n  \"tenantServiceOptIn-Energy\": true,\n  \"voidService\": true,\n  \"gasMeterReading\": \"string\",\n  \"gasMeterReadingDate\": \"string\",\n  \"electricMeterReading\": \"string\",\n  \"electricMeterReading_2\": \"string\",\n  \"electricMeterReadingDate\": \"string\",\n  \"waterMeterReading\": \"string\",\n  \"waterMeterReadingDate\": \"string\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete a tenancy",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/tenancies/:tenancyId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tenancies",
                ":tenancyId"
              ],
              "variable": [
                {
                  "key": "tenancyId",
                  "value": "0"
                }
              ]
            },
            "description": "Removes the tenancy. Landlords and properties cannot be deleted through the API."
          }
        },
        {
          "name": "Give notice, then closing readings",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tenancies/:tenancyId/end",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tenancies",
                ":tenancyId",
                "end"
              ],
              "variable": [
                {
                  "key": "tenancyId",
                  "value": "0"
                }
              ]
            },
            "description": "Call it twice. First as soon as notice is given, when the readings and forwarding address can be left empty. Then again on move-out with the closing readings and the forwarding address.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tenancyEnd\": \"string\",\n  \"propertyId\": 0,\n  \"sendCouncilAndUtilityNotifications\": true,\n  \"whoIsResponsibleForTheVoidPeriod\": \"string\",\n  \"voidBillCorrespondenceAddress\": \"string\",\n  \"isFurnished\": true,\n  \"areAnyBillsIncludedInTheRent\": {\n    \"councilTax\": true,\n    \"gas\": true,\n    \"electric\": true,\n    \"water\": true\n  },\n  \"tenantServiceOptIn-Media\": true,\n  \"tenantServiceOptIn-Energy\": true,\n  \"voidService\": true,\n  \"stillManageTheProperty\": true,\n  \"endElectricityReading\": {\n    \"meterReading1\": \"string\",\n    \"meterReading2\": \"string\",\n    \"meterReadingDate\": \"string\"\n  },\n  \"endGasReading\": {\n    \"meterReading\": \"string\",\n    \"meterReadingDate\": \"string\"\n  },\n  \"endWaterReading\": {\n    \"meterReading\": \"string\",\n    \"meterReadingDate\": \"string\"\n  },\n  \"forwardingAddress\": {\n    \"addressLine1\": \"string\",\n    \"addressLine2\": \"string\",\n    \"addressLine3\": \"string\",\n    \"townOrCity\": \"string\",\n    \"county\": \"string\",\n    \"postcode\": \"string\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Send move-in readings",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tenancies/:tenancyId/start",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tenancies",
                ":tenancyId",
                "start"
              ],
              "variable": [
                {
                  "key": "tenancyId",
                  "value": "0"
                }
              ]
            },
            "description": "Once the check-in inventory is done. Aim for within five days of move-in: the later the readings, the more likely billing issues become.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"startElectricityReading\": {\n    \"meterReading1\": \"string\",\n    \"meterReading2\": \"string\",\n    \"meterReadingDate\": \"string\"\n  },\n  \"startGasReading\": {\n    \"meterReading\": \"string\",\n    \"meterReadingDate\": \"string\"\n  },\n  \"startWaterReading\": {\n    \"meterReading\": \"string\",\n    \"meterReadingDate\": \"string\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update the forwarding address",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/updateForwardingAddress/:tenancyId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "updateForwardingAddress",
                ":tenancyId"
              ],
              "variable": [
                {
                  "key": "tenancyId",
                  "value": "0"
                }
              ]
            },
            "description": "Use this if the forwarding address changes after the end of tenancy has been sent.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"forwardingAddress\": {\n    \"addressLine1\": \"string\",\n    \"addressLine2\": \"string\",\n    \"addressLine3\": \"string\",\n    \"townOrCity\": \"string\",\n    \"county\": \"string\",\n    \"postcode\": \"string\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
