{
  "info": {
    "name": "Muuvo Partner API",
    "description": "Every partner endpoint, ready to try against staging. Set the apiKey variable to your staging key. Guide: https://developerguide.muuvo.dev/",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "apikey",
    "apikey": [
      {
        "key": "key",
        "value": "X-Muuvo-Key",
        "type": "string"
      },
      {
        "key": "value",
        "value": "{{apiKey}}",
        "type": "string"
      },
      {
        "key": "in",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://agent.muuvostaging.com/services"
    },
    {
      "key": "apiKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Landlords",
      "item": [
        {
          "name": "List all landlords",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/landlords",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "landlords"
              ],
              "variable": []
            },
            "description": "Returns every landlord on your account."
          }
        },
        {
          "name": "Create a landlord",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/landlords",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "landlords"
              ],
              "variable": []
            },
            "description": "Create the landlord first. Keep the returned resultId as the landlordId for the property.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"string\",\n  \"firstName\": \"string\",\n  \"lastName\": \"string\",\n  \"companyName\": \"string\",\n  \"contactNumber\": \"string\",\n  \"email\": \"string\",\n  \"address\": {\n    \"addressLine1\": \"string\",\n    \"addressLine2\": \"string\",\n    \"addressLine3\": \"string\",\n    \"townOrCity\": \"string\",\n    \"county\": \"string\",\n    \"postcode\": \"string\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Get a landlord",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/landlords/:landlordId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "landlords",
                ":landlordId"
              ],
              "variable": [
                {
                  "key": "landlordId",
                  "value": "0"
                }
              ]
            },
            "description": "Returns one landlord."
          }
        },
        {
          "name": "Update a landlord",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/landlords/:landlordId",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "landlords",
                ":landlordId"
              ],
              "variable": [
                {
                  "key": "landlordId",
                  "value": "0"
                }
              ]
            },
            "description": "Send the full landlord record with the corrections.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"string\",\n  \"firstName\": \"string\",\n  \"lastName\": \"string\",\n  \"companyName\": \"string\",\n  \"contactNumber\": \"string\",\n  \"email\": \"string\",\n  \"address\": {\n    \"addressLine1\": \"string\",\n    \"addressLine2\": \"string\",\n    \"addressLine3\": \"string\",\n    \"townOrCity\": \"string\",\n    \"county\": \"string\",\n    \"postcode\": \"string\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
